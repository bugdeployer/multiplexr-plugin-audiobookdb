{
  "id": "com.bugdeployer.audiobookdb",
  "version": "0.2.0",
  "name": "AudiobookDB metadata",
  "entry": "plugin.js",
  "protocol": {
    "min": 1,
    "max": 1
  },
  "capabilities": {
    "required": [
      "metadata.provide",
      "http.request",
      "credentials.use",
      "settings.read",
      "settings.write"
    ],
    "optional": []
  },
  "contributions": [
    {
      "id": "com.bugdeployer.audiobookdb:metadata",
      "family": "metadata.provider",
      "title": "AudiobookDB",
      "handler": "metadata.search",
      "kinds": [
        "audiobook"
      ]
    },
    {
      "id": "com.bugdeployer.audiobookdb:access",
      "family": "settings.section",
      "title": "Integration access",
      "description": "AudiobookDB requires a written agreement for public integrations. Enable only when this use is covered.",
      "icon": "settings",
      "schemaVersion": 1,
      "scopes": [
        "app"
      ],
      "fields": [
        {
          "id": "com.bugdeployer.audiobookdb:integrationApproved",
          "type": "boolean",
          "label": "Written integration approval obtained",
          "accessibleLabel": "Written integration approval obtained",
          "default": false,
          "scopes": [
            "app"
          ]
        }
      ]
    }
  ]
}
